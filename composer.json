{
    "name": "kylewlawrence/waboxapp-laravel",
    "type": "library",
    "description": "Laravel API for WaboxApp",
    "minimum-stability": "stable",
    "keywords": [
        "waboxapp",
        "laravel",
        "rest-api"
    ],
    "homepage": "https://designanddevelop.io",
    "license": "MIT",
    "authors": [
        {
            "name": "KyleWLawrence",
            "email": "Kyle@DesignAndDevelop.io"
        }
    ],
    "require": {
        "guzzlehttp/guzzle": "^7.16 || ^8.3",
        "guzzlehttp/psr7": "^2.13 || ^3.2",
        "illuminate/support": "^13.0",
        "php": "^8.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "KyleWLawrence\\WaboxApp\\Providers\\WaboxAppServiceProvider"
            ],
            "aliases": {
                "WaboxApp": "KyleWLawrence\\WaboxApp\\Facades\\WaboxApp"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "KyleWLawrence\\WaboxApp\\": "src"
        }
    },
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/vendor",
            "/.history",
            "/.env",
            "/.env.*",
            "/composer.lock"
        ]
    }
}
